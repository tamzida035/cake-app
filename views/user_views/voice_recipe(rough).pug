extends user_base
block content
 //breadcrumb
 section(id="breadcrumb" class="center_o bg-light pt-3 pb-3")
  div(class="container-xl")
   div(class="row center_o1")
    div(class="col-md-12")
     h6(class="mb-0 col_green")
      a(href="/users/profile/:id/") Home
      span(class="me-2 ms-2")
       i(class="bi bi-caret-right-fill align-middle text-muted") 
       Add Add recipe by Voice
 //form
 div(class="container" id="ingred_form_container")
  div(class="row justify-content-center")
   div(class="col-md-10")
    form(action="/users/add_new_recipe_by_voice" method="post" id="voiceRecipeForm")
     div(class="contact_1r shadow p-4")
      div(class="contact_1ri row")
       div(class="col-md-12")
        div(class="form-group")
         label(for="recipe_step") 
          h5 INSTRUCTION FOR ADDING RECIPE
          //add space
          div(class="row mb-3")
          //add red symbol for 1st instruction
          div(class="work_1 row")
           div(class="col-md-1")
            div(class="work_i position-relative")
             div(class="work_i2 text-center clearfix position-absolute w-100")
              span(class="d-inline-block bg_red text-white")
               1
          //add spaces
          div(class="row mb-3")
          div(class="row mb-3")
          p Grant permission to access microphone when prompted
          //add red symbol for 2nd instruction
          div(class="work_1 row")
           div(class="col-md-1")
            div(class="work_i position-relative")
             div(class="work_i2 text-center clearfix position-absolute w-100")
              span(class="d-inline-block bg_red text-white")
               2
          //add spaces
          div(class="row mb-3")
          div(class="row mb-3")
          p Speak clearly at normal pace
          //add red symbol for 3rd instruction
          div(class="work_1 row")
           div(class="col-md-1")
            div(class="work_i position-relative")
             div(class="work_i2 text-center clearfix position-absolute w-100")
              span(class="d-inline-block bg_red text-white")
               3
          //add spaces
          div(class="row mb-3")
          div(class="row mb-3")
          p Say 'next step' after finish saying current step to move to next step.
          //add red symbol for 4th instruction
          div(class="work_1 row")
           div(class="col-md-1")
            div(class="work_i position-relative")
             div(class="work_i2 text-center clearfix position-absolute w-100")
              span(class="d-inline-block bg_red text-white")
               4
          //add spaces
          div(class="row mb-3")
          div(class="row mb-3")
          p Say 'last step' after finish saying current step to mark end of recipe.
          //add red symbol for 5th instruction
          div(class="work_1 row")
           div(class="col-md-1")
            div(class="work_i position-relative")
             div(class="work_i2 text-center clearfix position-absolute w-100")
              span(class="d-inline-block bg_red text-white")
               5
          //add spaces
          div(class="row mb-3")
          div(class="row mb-3")
          p To mark beginning of a special section of recipe, say for e.g. 'steps for making crust'.
          //add red symbol for 6th instruction
          div(class="work_1 row")
           div(class="col-md-1")
            div(class="work_i position-relative")
             div(class="work_i2 text-center clearfix position-absolute w-100")
              span(class="d-inline-block bg_red text-white")
               6
          //add spaces
          div(class="row mb-3")
          div(class="row mb-3")
          p To mark end of a special section of recipe, say 'end of special section'.
